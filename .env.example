# Local development settings for Docker Compose.
#
#   cp .env.example .env
#
# .env is ignored by Git and by the Docker build context, so real values never
# get committed or baked into an image. Keep placeholders only in this file.

POSTGRES_DB=mayn
POSTGRES_USER=mayn

# Replace this with your own password. Because Compose builds DATABASE_URL from
# it, use only letters, digits, "-" and "_"; characters such as @ : / ? # %
# would break the URL. Generate one with:  openssl rand -hex 16
POSTGRES_PASSWORD=change-me

# NOT used by Compose. Setting DATABASE_URL yourself is for running the Go
# server directly (`go run ./cmd/server`) against a database you started, and
# for production, where the host provides it (for Neon, with sslmode=require).
# DATABASE_URL=postgres://mayn:change-me@localhost:5432/mayn?sslmode=disable
